<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="lwy.study.spring.mapper.AdminMapper">

    <resultMap id="adminMap" type="admin">
        <id property="adminId" column="admin_id"/>
        <result property="adminName" column="admin_name"/>
        <result property="adminPassword" column="admin_password"/>
        <result property="adminEmail" column="admin_email"/>
        <result property="adminRole" column="admin_role"/>
        <result property="adminStatus" column="admin_status"/>
    </resultMap>

    <select id="selectByEmail" resultMap="adminMap">
        select * from admin where admin_email = #{email}
    </select>

</mapper>
